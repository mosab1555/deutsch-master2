# Production environment — copy to server/.env (NEVER commit real secrets)
NODE_ENV=production
PORT=4000
APP_URL=https://api.example.com
CORS_ORIGINS=https://shop.example.com
# PostgreSQL (required in production):
DATABASE_URL=postgres://dmm:CHANGE_ME@db-host:5432/dmm
# Auth:
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_OTHER_64_HEX_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Stripe (online cards). Empty = COD only. Never store card data.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MOCK=false
# SMTP (empty = dev logger into mail_log table)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# Shipping carrier API (live rates/tracking when wired)
SHIPPING_API_KEY=
# Cloudinary unsigned upload (fallback: local disk ./uploads served at /uploads)
CLOUDINARY_CLOUD=
CLOUDINARY_PRESET=
# S3-compatible storage seam (interface in server/src/storage.js)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAPS_API_KEY=
