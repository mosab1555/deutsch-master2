{
  "name": "deutsch-master",
  "version": "1.0.0",
  "private": true,
  "description": "Deutsch Master - Arabic-friendly German-learning platform (A1-B2): static PWA in client/, generated mobile shell in www/ via Capacitor, Windows shell via Electron",
  "main": "electron/main.js",
  "scripts": {
    "test": "node tools/run-phase0-tests.js && node tools/test-academy-core.js && node tools/test-academy-rls-static.js",
    "test:phase0": "node tools/run-phase0-tests.js",
    "test:academy": "node tools/test-academy-core.js",
    "test:parity": "node tools/check-www-parity.js",
    "www": "node tools/make-www.js",
    "sync": "npm run www && cap sync",
    "android": "cap open android",
    "apk": "npm run www && cap sync android && cd android && gradlew assembleDebug",
    "apk-release": "npm run www && cap sync android && cd android && gradlew assembleRelease",
    "start-win": "electron electron/main.js",
    "dist-win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.deutschmaster.app",
    "productName": "Deutsch Master",
    "files": [
      "client/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Deutsch Master",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Deutsch-Master-Portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/ios": "^6.2.2"
  }
}
